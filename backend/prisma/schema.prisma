datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum SubTier {
  FREE
  PREMIUM
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String?
  googleId      String?
  name          String
  role          Role      @default(STUDENT)
  subscription  SubTier   @default(FREE)
  xpPoints      Int       @default(0)
  studyStreak   Int       @default(0)
  
  pdfs          Pdf[]
  notes         Note[]
  quizzes       Quiz[]
  flashcards    Flashcard[]
  studyPlans    StudyPlan[]
  chats         Chat[]
  bookmarks     Bookmark[]
  downloads     Download[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Pdf {
  id            String    @id @default(uuid())
  userId        String
  title         String
  fileUrl       String
  tags          String[]
  summary       String?
  isPublic      Boolean   @default(false)
  categoryId    String?
  branchId      String?
  subjectId     String?
  semester      Int?
  thumbnailUrl  String?
  downloadCount Int       @default(0)
  
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks        DocumentChunk[]
  category      Category? @relation(fields: [categoryId], references: [id])
  branch        Branch?   @relation(fields: [branchId], references: [id])
  subject       Subject?  @relation(fields: [subjectId], references: [id])
  bookmarks     Bookmark[]
  downloads     Download[]
  
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([categoryId])
}

model DocumentChunk {
  id            String    @id @default(uuid())
  pdfId         String
  content       String
  embedding     Unsupported("vector(1536)")? 
  
  pdf           Pdf       @relation(fields: [pdfId], references: [id], onDelete: Cascade)

  @@index([pdfId])
}

model Note {
  id            String    @id @default(uuid())
  userId        String
  title         String
  content       String    @db.Text
  
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
}

model Quiz {
  id            String    @id @default(uuid())
  userId        String
  title         String
  topic         String
  score         Float?
  isPublic      Boolean   @default(false)
  
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions     Question[]
  
  createdAt     DateTime  @default(now())

  @@index([userId])
}

model Question {
  id            String    @id @default(uuid())
  quizId        String
  prompt        String
  options       Json      // Array of string options
  answer        String
  explanation   String?
  
  quiz          Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

model Flashcard {
  id            String    @id @default(uuid())
  userId        String
  front         String
  back          String
  
  interval      Int       @default(0)
  repetition    Int       @default(0)
  easeFactor    Float     @default(2.5)
  nextReview    DateTime  @default(now())
  
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Chat {
  id            String    @id @default(uuid())
  userId        String
  title         String
  
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      Message[]
  
  createdAt     DateTime  @default(now())

  @@index([userId])
}

model Message {
  id            String    @id @default(uuid())
  chatId        String
  role          String    // "user" or "assistant"
  content       String    @db.Text
  
  chat          Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())

  @@index([chatId])
}

model StudyPlan {
  id            String    @id @default(uuid())
  userId        String
  title         String
  
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks         Task[]
  
  createdAt     DateTime  @default(now())

  @@index([userId])
}

model Task {
  id            String    @id @default(uuid())
  planId        String
  title         String
  isCompleted   Boolean   @default(false)
  dueDate       DateTime?
  
  plan          StudyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  branches    Branch[]
  pdfs        Pdf[]
}

model Branch {
  id          String   @id @default(uuid())
  categoryId  String
  name        String
  description String?
  subjects    Subject[]
  pdfs        Pdf[]

  category    Category @relation(fields: [categoryId], references: [id])
}

model Subject {
  id          String   @id @default(uuid())
  branchId    String?
  name        String
  description String?
  pdfs        Pdf[]

  branch      Branch?  @relation(fields: [branchId], references: [id])
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  pdfId     String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pdf       Pdf      @relation(fields: [pdfId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([pdfId])
}

model Download {
  id        String   @id @default(uuid())
  userId    String
  pdfId     String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pdf       Pdf      @relation(fields: [pdfId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([pdfId])
}
