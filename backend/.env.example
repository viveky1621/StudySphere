# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
# Neon PostgreSQL format often includes ?pgbouncer=true or similar query parameters
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/studysphere?schema=public"

# JWT Secret for authentication (Must be strong and unique in production)
JWT_SECRET="generate_a_strong_random_secret_here"

# Port for the Express Server
PORT=3000

# CORS Configuration (Set to your frontend URL in production, e.g., https://app.studysphere.ai)
CORS_ORIGIN="*"

# Redis Connection (For BullMQ)
REDIS_HOST="localhost"
REDIS_PORT="6379"
# REDIS_PASSWORD=""

# Google OAuth
GOOGLE_CLIENT_ID="your_google_client_id_here"

# Set to 'production' in your Render/Neon environment
NODE_ENV="development"

# Feature flags and external services
MOCK_DATABASE=true
OPENAI_API_KEY="sk-..."
AWS_ACCESS_KEY_ID="..."
AWS_SECRET_ACCESS_KEY="..."
AWS_S3_BUCKET_NAME="studysphere-assets"
